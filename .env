# Le "Mot de passe d'application" généré depuis votre compte Google
# (Ce n'est pas le mot de passe habituel de la boîte mail !)
SENDER_PASSWORD=iksi vdcz ansa vzhh

# L'adresse email qui doit recevoir les alertes (peut être la même que SENDER_EMAIL ou plusieurs séparés par des virgules)
RECEIVER_EMAIL=maresteph06@gmail.com
