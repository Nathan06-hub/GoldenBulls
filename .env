# Paramètres pour l'envoi d'e-mail (SMTP)
# Pour Gmail, utilisez le serveur "smtp.gmail.com" et le port 587
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# L'adresse email qui envoie le message
